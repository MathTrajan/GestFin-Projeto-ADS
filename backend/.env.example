# Ambiente de execução: development ou production
NODE_ENV=development

# Porta da API
PORT=3600

# Conexão com o PostgreSQL.
# Ajuste o usuário e a porta conforme a sua instalação.
DATABASE_URL=postgresql://localhost:5433/gestfin_dev

# Segredo que assina os cookies de sessão.
# Em produção é OBRIGATÓRIO e deve ser um valor aleatório longo.
# Gere um com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
COOKIE_SECRET=

# Origem autorizada do front-end em desenvolvimento
CORS_ORIGIN=http://localhost:4300
