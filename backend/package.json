{
  "name": "capital-backend",
  "version": "1.0.0",
  "description": "API REST do GestFin, sistema de gestão financeira doméstica",
  "private": true,
  "main": "src/server.js",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node ../database/run-migrations.js",
    "migrate:status": "node ../database/run-migrations.js --status",
    "seed": "node ../database/run-migrations.js --seed",
    "test": "node --test tests/*.test.js",
    "test:integration": "node --test tests/integracao/",
    "test:all": "npm test && npm run test:integration"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.1"
  }
}
